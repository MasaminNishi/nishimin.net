<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@handle@ — @domain@</title>
    <meta name="description" content="@tagline@" />
    <!-- CSS は剥いである。color-scheme はブラウザ既定の配色を
         OS のダークモードに追随させるためのもので、スタイルではない。 -->
    <meta name="color-scheme" content="dark light" />
    <link rel="canonical" href="@url@/" />
    <link rel="me" href="mailto:@email@" />
    <link rel="icon" href="data:," />
  </head>
  <body>
    <main>
      <header>
        <h1>@handle@</h1>
        <p>@tagline@</p>
        <p>@realName@ · @location@</p>
        <ul>
@links@
        </ul>
      </header>

      <section>
        <h2>Keys</h2>
        <p>公開鍵はプレーンテキストで直接取得できる。</p>

        <h3>SSH</h3>
        <pre><code>@cmdSsh@</code></pre>
      </section>

      <section>
        <h2>Identity</h2>
        <dl>
          <dt>Nostr (NIP-05)</dt>
          <dd>
            <code>_@@domain@</code>
            <a href="@nostrJsonHref@">nostr.json</a>
          </dd>
          <dt>Nostr Picture (kind:0)</dt>
          <dd>
            <a href="@nostrPictureHref@">@nostrPictureHref@</a>
            <div>
              <img src="@nostrPictureHref@" alt="Nostr profile picture" width="160" height="160" />
            </div>
          </dd>
        </dl>
      </section>

      <section>
        <h2>CLI</h2>
        <p>
          <code>curl</code> でアクセスすると HTML ではなく ANSI カラーのプロフィールが返る。
        </p>
        <pre><code>curl @url@</code></pre>
      </section>

      <section>
        <h2>Meta</h2>
        <ul>
          <li><a href="@securityTxtHref@">security.txt</a> — 脆弱性連絡窓口 (RFC 9116)</li>
          <li><a href="@humansTxtHref@">humans.txt</a> — 制作者・使用技術</li>
        </ul>

        <h3>Stack</h3>
        <ul>
@stack@
        </ul>
      </section>
    </main>
  </body>
</html>
