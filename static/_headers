# Cloudflare Pages のヘッダ定義。ダッシュボードではなくこのファイルが正。
# 上から評価され、マッチしたルールがすべて適用される。
#
# ここに足したルールは Function の応答にも自動で乗る
# （functions/_middleware.ts が静的アセットの応答から引き写す）。

# Nostr NIP-05 はブラウザのクライアントから読まれるので CORS 必須。
/.well-known/nostr.json
  Access-Control-Allow-Origin: *
  Content-Type: application/json; charset=utf-8

# 公開鍵・テキストエンドポイントは拡張子が無いので Content-Type を明示する。
/keys
  Content-Type: text/plain; charset=utf-8

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8

# Nostr のプロフィール画像。更新はあり得るので immutable にはしない。
/image/*
  Cache-Control: public, max-age=3600

# セキュリティヘッダ全般。
# X-Content-Type-Options は _middleware.ts が「適用済みマーカー」として使うので消さないこと。
# CSP の style-src は現在 CSS が無いので効いていないが、あとでスタイルを戻すときに
# CSP 側の編集を忘れて「読み込まれない」と悩まないよう残してある。
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: document-domain=(), microphone=(), camera=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'none'; img-src 'self'; style-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
